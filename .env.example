# VibeDrive Environment Variables
# Copy to .env and update with your values

# Application
APP_ENV="dev | test | uat | prod"
APP_NAME=VibeDrive
APP_VERSION=0.1.0
DEBUG=true

# Database
DATABASE_URL=postgresql://secret-change-in-environment
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT=30

# Flask
SECRET_KEY=secret-change-in-environment

# Authentication
JWT_SECRET=secret-change-in-environment
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=learning_resources

# OpenAI / LLM
ANTHROPIC_API_KEY=secret-change-in-environment
ANTHROPIC_MODEL=
