# ═════════════════════════════════════════════════════════════════════════════
# VibeDrive Environment Variables
# Copy this to .env and fill in your specific values.
# ═════════════════════════════════════════════════════════════════════════════


# --- Application -------------------------------------------------------------
APP_ENV="dev | test | uat | prod"
APP_NAME=VibeDrive
APP_VERSION=0.1.0
DEBUG=true

# --- Database
DATABASE_URL="postgresql://secret-change-in-environment"
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT=30

# --- Flask
SECRET_KEY="secret-change-in-environment"

# --- Authentication
JWT_SECRET="secret-change-in-environment"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=30

# --- Redis
REDIS_URL="redis://localhost:6379/0"

# --- QDrant Vector Database
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION="learning_resources"

# --- Anthropic ---------------------------------------------------------------
ANTHROPIC_API_KEY=secret-change-in-environment
ANTHROPIC_MODEL="claude-haiku-4-5-20251001 | claude-sonnet-5 | claude-opus-5 | claude-fable-5-1"

# ── Common LLM tuning ────────────────────────────────────────────────────────
TEMPERATURE=0.3
MAX_TOKENS=1024

# ── Provider observability ───────────────────────────────────────────────────
# Prints one compact provider line to stderr whenever a chat model is created.
LLM_PROVIDER_OBSERVABILITY=true

# LangSmith (optional — for tracing and evaluation)
LANGSMITH_API_KEY=secret-change-in-environment
LANGSMITH_TRACING=false
LANGSMITH_PROJECT="vibedrive"
